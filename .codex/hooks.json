{
  "_comment": "Template for Codex hooks. scripts/install-codex.sh substitutes __CLAUDE_LEVERAGE_DIR__ with the absolute path of this repo at install time and writes the resolved file to ~/.codex/hooks.json. Do not edit __CLAUDE_LEVERAGE_DIR__ — it's the install-time placeholder.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_LEVERAGE_DIR__/scripts/hooks/stack-freshness.sh"
          },
          {
            "type": "command",
            "command": "__CLAUDE_LEVERAGE_DIR__/scripts/hooks/bare-repo-nudge.sh"
          },
          {
            "type": "command",
            "command": "__CLAUDE_LEVERAGE_DIR__/scripts/hooks/skill-cheatsheet.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_LEVERAGE_DIR__/scripts/hooks/block-secrets-precommit.sh",
            "statusMessage": "Scanning staged diff for secrets"
          },
          {
            "type": "command",
            "command": "__CLAUDE_LEVERAGE_DIR__/scripts/hooks/block-dangerous-git.sh",
            "statusMessage": "Checking for dangerous git operations"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Write$|^Edit$|^MultiEdit$",
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_LEVERAGE_DIR__/scripts/hooks/ai-first-nudge.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_LEVERAGE_DIR__/scripts/hooks/security-nudge.sh"
          }
        ]
      }
    ]
  }
}
